<?xml version="1.0" ?>
<resources>
    <style name="Theme.Forbidden.Main" parent="Theme.Forbidden">
        <item name="colorPrimary">@color/main_accent</item>
        <item name="colorPrimaryVariant">@color/main_hero</item>
        <item name="colorSecondary">@color/main_accent</item>
        <item name="colorSurface">@color/main_card</item>
        <item name="colorOnSurface">@color/main_text</item>
        <item name="colorOnPrimary">@color/main_on_accent</item>
        <item name="android:textColorPrimary">@color/main_text</item>
        <item name="android:textColorSecondary">@color/main_muted</item>
        <item name="android:windowBackground">@color/main_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="MainCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/main_card</item>
        <item name="strokeColor">@color/main_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="MainButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="MainButton.Outline" parent="MainButton">
        <item name="backgroundTint">@color/main_card</item>
        <item name="android:textColor">@color/main_accent</item>
        <item name="strokeColor">@color/main_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="MainText.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/main_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="MainText.Heading" parent="MainText.Body">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/main_text</item>
    </style>
    <style name="MainText.Section" parent="MainText.Heading">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="MainText.Eyebrow" parent="MainText.Body">
        <item name="android:textColor">@color/main_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="MainText.Caption" parent="MainText.Body">
        <item name="android:textSize">12sp</item>
    </style>
</resources>
